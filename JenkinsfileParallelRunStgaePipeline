pipeline{
    agent any
    tools{
        maven 'mymaven'
    }
    stages{
        stage('Parallel Stage Run'{
            parallel {
                stage('Compile the code'){
                    git 'https://github.com/Sonal0409/DevOpsCodeDemo.git'
                    sh 'mvn compile'
                }
                stage('Review the code'){
                    git 'https://github.com/Sonal0409/DevOpsCodeDemo.git'
                    sh 'mvn pmd:pmd'
                }
            }
        }

    }
}